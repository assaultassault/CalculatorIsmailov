<Window x:Class="IsmailovCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="540" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="#12131C"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="CalcButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E202E"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3142"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#181A25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="#2A2238"/>
            <Setter Property="Foreground" Value="#FF6B81"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="#252A44"/>
            <Setter Property="Foreground" Value="#00D2D3"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource CalcButtonStyle}">
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5B4BC4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#483A9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1A1C29"
                BorderBrush="#2A2D42"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding ExpressionLabelText}" 
                           Foreground="#6C7A89" 
                           FontSize="12" 
                           FontWeight="Medium"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" 
                         Foreground="#F1F2F6" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         FontSize="22" 
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right" 
                         TextAlignment="Right"/>
                <TextBlock Text="{Binding ResultText}" 
                           Foreground="#00E676" 
                           FontSize="30" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Right" 
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="C" Command="{Binding ClearAllCommand}" Grid.Row="0" Grid.Column="0" Margin="4" Style="{StaticResource FunctionButtonStyle}"/>
            <Button Content="CE" Command="{Binding ClearEntryCommand}" Grid.Row="0" Grid.Column="1" Margin="4" Style="{StaticResource FunctionButtonStyle}"/>
            <Button Content="⌫" Command="{Binding BackspaceCommand}" Grid.Row="0" Grid.Column="2" Margin="4" Style="{StaticResource FunctionButtonStyle}"/>
            <Button Content="^" Command="{Binding AppendCommand}" CommandParameter="^" Grid.Row="0" Grid.Column="3" Margin="4" Style="{StaticResource AccentButtonStyle}"/>

            <Button Content="(" Command="{Binding AppendCommand}" CommandParameter="(" Grid.Row="1" Grid.Column="0" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content=")" Command="{Binding AppendCommand}" CommandParameter=")" Grid.Row="1" Grid.Column="1" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="/" Command="{Binding AppendCommand}" CommandParameter="/" Grid.Row="1" Grid.Column="2" Margin="4" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="*" Command="{Binding AppendCommand}" CommandParameter="*" Grid.Row="1" Grid.Column="3" Margin="4" Style="{StaticResource AccentButtonStyle}"/>

            <Button Content="7" Command="{Binding AppendCommand}" CommandParameter="7" Grid.Row="2" Grid.Column="0" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="8" Command="{Binding AppendCommand}" CommandParameter="8" Grid.Row="2" Grid.Column="1" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="9" Command="{Binding AppendCommand}" CommandParameter="9" Grid.Row="2" Grid.Column="2" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="-" Command="{Binding AppendCommand}" CommandParameter="-" Grid.Row="2" Grid.Column="3" Margin="4" Style="{StaticResource AccentButtonStyle}"/>

            <Button Content="4" Command="{Binding AppendCommand}" CommandParameter="4" Grid.Row="3" Grid.Column="0" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="5" Command="{Binding AppendCommand}" CommandParameter="5" Grid.Row="3" Grid.Column="1" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="6" Command="{Binding AppendCommand}" CommandParameter="6" Grid.Row="3" Grid.Column="2" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="+" Command="{Binding AppendCommand}" CommandParameter="+" Grid.Row="3" Grid.Column="3" Margin="4" Style="{StaticResource AccentButtonStyle}"/>

            <Button Content="1" Command="{Binding AppendCommand}" CommandParameter="1" Grid.Row="4" Grid.Column="0" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="2" Command="{Binding AppendCommand}" CommandParameter="2" Grid.Row="4" Grid.Column="1" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="3" Command="{Binding AppendCommand}" CommandParameter="3" Grid.Row="4" Grid.Column="2" Margin="4" Style="{StaticResource CalcButtonStyle}"/>
            <Button Content="=" Command="{Binding EvaluateCommand}" Grid.Row="4" Grid.Column="3" Margin="4" Style="{StaticResource EqualsButtonStyle}"/>
        </Grid>
    </Grid>
</Window>